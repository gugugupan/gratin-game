{
  "name": "gratin-game",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:all": "npm run build && npm run build --workspaces && node scripts/assemble.mjs",
    "test:all": "npm test && npm run verify-levels -w games/gridlands/web && npm test -w games/paper-quarantine",
    "preview": "vite preview",
    "test": "vitest run",
    "brand": "node scripts/build-brand.mjs"
  },
  "devDependencies": {
    "@fontsource/dela-gothic-one": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/zen-maru-gothic": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20.19.43",
    "opentype.js": "^2.0.0",
    "png-to-ico": "^3.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  },
  "workspaces": [
    "games/gridlands/web",
    "games/paper-quarantine"
  ]
}
